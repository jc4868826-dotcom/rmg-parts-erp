# ============================================================
# RMG Auto Parts — Variables de entorno
# Copiar como .env y completar con credenciales reales
# NUNCA subir .env a GitHub
# ============================================================

# --- APP ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# --- SQLite (Base de datos local / Render disk) ---
# En Render: usar ruta de disco persistente, ej. /var/data/rmg_parts.db
DB_PATH=./database/rmg_parts.db

# --- JWT ---
JWT_SECRET=rmg_autoparts_super_secret_key_2026_change_this
JWT_EXPIRES_IN=7d

# --- META (Facebook/Instagram Ads + WhatsApp) ---
META_APP_ID=TU_META_APP_ID
META_APP_SECRET=TU_META_APP_SECRET
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx
META_WHATSAPP_PHONE_ID=TU_WHATSAPP_PHONE_ID
META_WHATSAPP_TOKEN=TU_WHATSAPP_TOKEN
META_WEBHOOK_VERIFY_TOKEN=rmg_webhook_verify_2026
META_AD_ACCOUNT_ID=act_TU_AD_ACCOUNT_ID
META_PIXEL_ID=TU_PIXEL_ID

# --- GOOGLE ---
GOOGLE_ADS_DEVELOPER_TOKEN=TU_DEVELOPER_TOKEN
GOOGLE_ADS_CLIENT_ID=TU_CLIENT_ID
GOOGLE_ADS_CLIENT_SECRET=TU_CLIENT_SECRET
GOOGLE_ADS_REFRESH_TOKEN=TU_REFRESH_TOKEN
GOOGLE_ADS_CUSTOMER_ID=TU_CUSTOMER_ID

# --- EMAIL (SendGrid) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxx
EMAIL_FROM=contacto@rmgautoparts.cl
EMAIL_FROM_NAME=RMG Auto Parts

# --- RENDER (Deploy) ---
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxx

# --- CATA (bot WhatsApp de RMG Autos consultando el ERP de RMG Parts) ---
# Clave compartida servidor-a-servidor para /api/public/catalogo-precios y
# /api/public/pedido-estado. Debe ser EXACTAMENTE el mismo valor que RMG_PARTS_API_KEY
# en el .env de "negocio sistemas" (el proyecto de Cata). Generar con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CATA_API_KEY=TU_CLAVE_COMPARTIDA_CON_CATA

# --- ChileCompra / Mercado Público (asistente de oportunidades) ---
# Ticket de la API pública, se obtiene en mercadopublico.cl con la ClaveÚnica
# del representante legal (Raúl): https://api.mercadopublico.cl
CHILECOMPRA_API_TICKET=TU_TICKET_API_CHILECOMPRA
# Palabras clave para filtrar licitaciones/compras ágiles relevantes (separadas por coma)
CHILECOMPRA_KEYWORDS=lubricante,aceite motor,aceite hidraulico,bateria,neumatico,grasa industrial,refrigerante,adblue
# Cuántos días hacia atrás revisar en cada corrida (1 = solo el día de hoy)
CHILECOMPRA_DIAS_HACIA_ATRAS=1
# Correos que reciben el digest de las 9am (separados por coma)
CHILECOMPRA_ALERT_EMAILS=raul@rmgautoparts.cl,juancarlos@rmgautoparts.cl
# Ponderación del score compuesto: rentabilidad vs. seguridad (0-1, el resto va a seguridad)
CHILECOMPRA_PESO_RENTABILIDAD=0.6
# Requerido para la lectura de anexos con IA (chilecompraDocReader.js)
ANTHROPIC_API_KEY=TU_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- NEGOCIO RMG ---
RMG_EMPRESA=RMG Auto Parts
RMG_RUT=76.XXX.XXX-X
RMG_DIRECCION=Santiago, RM, Chile
RMG_TELEFONO=+56 9 XXXX XXXX
RMG_WHATSAPP=+56 9 XXXX XXXX
RMG_EMAIL=ventas@rmgautoparts.cl
